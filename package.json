{
  "name": "darling",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm -r --if-present dev",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "infra:up": "docker compose -p darling -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -p darling -f infra/docker-compose.yml down"
  }
}

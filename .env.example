# Copy to .env (never commit .env). Next.js loads it automatically; on Hostinger set the same variables in the panel.
NODE_ENV=development

# Public origin of the site (scheme + host, no path). Production must be https.
APP_ORIGIN=http://localhost:3000
# true in production (Secure cookies, HSTS). Defaults to true when APP_ORIGIN is https.
COOKIE_SECURE=false

# Directory holding darling.sqlite. Default ./.data (dev only). In production use a path OUTSIDE the app directory,
# e.g. /home/<user>/darling-data (a redeploy may replace the app directory). See deploy-check/README.md.
DATA_DIR=./.data
# ALLOW_DATA_IN_APP_DIR=true   # only if you accept that DATA_DIR lives inside the app directory in production

# 32 random bytes, base64. Encrypts TOTP secrets. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY=

# Number of trusted reverse proxies in front of the app (Hostinger: 1). 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# Mail (invites and password resets). Dev: Mailpit, `docker compose -p darling -f infra/docker-compose.yml up -d`, inbox http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="DARLING* <no-reply@darling7.store>"
